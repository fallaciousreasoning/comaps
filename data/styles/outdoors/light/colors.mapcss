/*
 * Keep here changes of the base map style files only
 * (see style.mapcss for exact processing order).
 */

@cycleway: #6D6D6D;

@pedestrian: #D2A254;
@footway: #6D6D6D;

@construction: #858282;

@railway: #433D3D;
@railway_dark: #433D3D;
@railway_dash: #433D3D;

@motorway1_border: #787878;
@trunk1_border: #787878;
@primary1_border: #787878;
@primary2_border: #787878;
@secondary0_border: #4E4E4E;
@secondary1_border: #4E4E4E;

/* LINZ tracks are #4E4E4E at 80%; outdoors draws them fully opaque. */
@track: #6D6D6D;
@path: #6D6D6D;
